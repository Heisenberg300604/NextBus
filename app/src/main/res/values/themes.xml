<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Window-level theme only. All in-app styling comes from the Compose Material 3 theme. -->
    <style name="Theme.NextBus" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Branded splash: white bus mark on brand blue, in light and dark mode. -->
    <style name="Theme.NextBus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NextBus</item>
    </style>
</resources>
